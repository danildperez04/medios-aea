{
  "name": "medios-aea",
  "version": "0.4.0",
  "description": "Gestión de medios (vehículos) de la Fundación Ayuda en Acción: solicitudes, aprobación sin choques de horario, bitácora de viajes y reportes",
  "private": true,
  "license": "UNLICENSED",
  "author": "Danild Pérez <danildperez04>",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @medios-aea/api --filter @medios-aea/web dev",
    "dev:api": "pnpm --filter @medios-aea/api dev",
    "dev:web": "pnpm --filter @medios-aea/web dev",
    "dev:mobile": "pnpm --filter @medios-aea/mobile start",
    "build": "pnpm --filter @medios-aea/api build && pnpm --filter @medios-aea/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @medios-aea/api test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md,yml,yaml}\"",
    "github:setup": "node scripts/github/setup.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "prepare": "husky",
    "db:migrate": "pnpm --filter @medios-aea/api build && pnpm --filter @medios-aea/api migration:run",
    "db:seed": "pnpm --filter @medios-aea/api seed:run",
    "prod:up": "./scripts/compose-prod.sh pull api web && ./scripts/compose-prod.sh up -d",
    "prod:down": "./scripts/compose-prod.sh down",
    "prod:ps": "./scripts/compose-prod.sh ps",
    "prod:logs": "./scripts/compose-prod.sh logs -f --tail=200",
    "prod:admin": "./scripts/compose-prod.sh exec api node dist/database/scripts/create-admin.js",
    "prod:backup": "./scripts/backup.sh",
    "prod:build": "./scripts/compose-prod.sh up -d --build"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  }
}
