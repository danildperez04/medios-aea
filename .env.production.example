# Variables de producción para docker-compose.prod.yml.
# Copiar a .env.production (está en .gitignore) y completar TODOS los valores marcados.

# Versión a desplegar: etiqueta publicada en GHCR (ver Releases en GitHub).
# Fijarla (p. ej. 0.4.0) para que reiniciar el servidor no cambie de versión sola.
APP_VERSION=latest
# Puerto del servidor por el que se entra al panel y a la API. 80 si no hay otro servicio.
WEB_PORT=80

# ---------- Base de datos ----------
DATABASE_NAME=medios_aea
DATABASE_USER=medios_aea
# CAMBIAR. Generar con: openssl rand -base64 24
DATABASE_PASSWORD=CAMBIAR_contraseña_larga_y_aleatoria
DATABASE_SSL=false

# ---------- Seguridad ----------
# CAMBIAR. Mínimo 32 caracteres. Generar con: openssl rand -hex 32
JWT_SECRET=CAMBIAR_por_un_secreto_aleatorio_de_64_caracteres
JWT_EXPIRES_IN=8h
# Sesión del panel web (ADR 0003): token de acceso en memoria y cookie de refresh.
WEB_ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_HOURS=12
# Sin dominio el panel va por HTTP y el navegador descarta una cookie Secure: la sesión
# se cerraría en cada recarga. Pásalo a true al servir por HTTPS (docs/11 §A.7); en un
# PaaS con HTTPS (Render) bórralo y vale true.
COOKIE_SECURE=false
BCRYPT_ROUNDS=12

# ---------- API ----------
API_PREFIX=api/v1
LOG_LEVEL=info
# Origen del panel web. Sin dominio: http://IP-DEL-SERVIDOR (y el puerto si no es 80).
CORS_ORIGIN=http://localhost
# Swagger (/api/docs) expone todos los endpoints: apagado en producción.
# Activarlo solo de forma temporal y en una red de confianza.
SWAGGER_ENABLED=false
