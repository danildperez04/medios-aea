# Plantilla de nginx. La imagen oficial sustituye ${PORT} y ${API_UPSTREAM} al
# arrancar (envsubst), así la misma imagen sirve en Docker Compose y en un PaaS.
#   PORT          puerto en el que escucha (los PaaS lo imponen). Default 8080 (sin root).
#   API_UPSTREAM  dónde está la API. Default http://api:3000 (servicio de Compose).

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 5m;
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
    gzip_min_length 1024;

    include /etc/nginx/snippets/security-headers.conf;

    # La web y la API comparten origen: el navegador nunca cruza dominios y no hace falta CORS.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Archivos con hash en el nombre: se cachean un año.
    location /assets/ {
        expires 1y;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Fuentes y archivos de marca opcionales: si faltan, 404. Sin esto, la regla
    # de la SPA devolvería index.html y el navegador intentaría leerlo como fuente.
    location ~ ^/(fonts|brand)/ {
        try_files $uri =404;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=86400";
    }

    # Rutas de la SPA (React Router): todo lo que no es archivo va a index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store";
    }
}
