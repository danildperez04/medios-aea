{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "rootDir": ".",
    "allowImportingTsExtensions": true,
    "incremental": false
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts", "vitest.e2e.config.ts"],
  "exclude": ["node_modules", "dist"]
}
