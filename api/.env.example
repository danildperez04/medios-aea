NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
LOG_LEVEL=info

DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=medios_aea
DATABASE_USER=medios_aea
DATABASE_PASSWORD=medios_aea
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false
DATABASE_SSL=false

JWT_SECRET=cambiame_por_un_secreto_aleatorio_de_64_caracteres_minimo
JWT_EXPIRES_IN=8h
# Sesión del panel web (ADR 0003): token de acceso en memoria y refresh token en cookie
WEB_ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_HOURS=12
# Cookie solo por HTTPS: por defecto true en producción y false en desarrollo.
# No lo fijes a false en un servidor.
# COOKIE_SECURE=
BCRYPT_ROUNDS=12

CORS_ORIGIN=http://localhost:5173

# Documentación interactiva en /api/docs. Por defecto: activa fuera de producción.
SWAGGER_ENABLED=true
